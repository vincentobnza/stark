# Copy to services/ai/.env and fill in. That file is gitignored.
# Restart the service (pnpm ai) after changing anything here.

# Required for the ElevenLabs voice. Without it the app uses the OS voice.
ELEVENLABS_API_KEY=

# Optional. Defaults to Rachel. GET http://127.0.0.1:8756/voices lists the
# voice ids on your account once the key above is set.
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# Optional. eleven_flash_v2_5 is the low-latency model and the right default
# for an assistant; eleven_multilingual_v2 sounds better but responds slower.
ELEVENLABS_MODEL=eleven_flash_v2_5

# Optional speech-recognition tuning.
# STARK_WHISPER_MODEL=small.en
# STARK_WHISPER_DEVICE=cpu
# STARK_WHISPER_COMPUTE=int8
