{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Stark",
  "version": "0.1.0",
  "identifier": "dev.vincent.stark",
  "build": {
    "beforeDevCommand": "pnpm run dev:vite",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "pnpm run build:vite",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "STARK",
        "width": 1280,
        "height": 860,
        "center": true,
        "resizable": true,
        "decorations": false,
        "transparent": false,
        "alwaysOnTop": false,
        "skipTaskbar": false,
        "shadow": true,
        "minWidth": 420,
        "minHeight": 520,
        "maximized": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
